{
  "name": "italent-replica",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:pg": "bash scripts/test-pg.sh",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @italent/db run db:generate",
    "db:migrate": "pnpm --filter @italent/db run db:migrate",
    "demo": "node scripts/demo.mjs",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:reset": "node scripts/demo.mjs reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@italent/api": "workspace:*",
    "@italent/db": "workspace:*",
    "@italent/domain": "workspace:*",
    "@italent/testkit": "workspace:*",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
