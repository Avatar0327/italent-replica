# 只写键名；值放本地 .env 或平台 Secret，切勿提交。
# 应用运行时连接（非超级用户、受 RLS 约束的角色）
DATABASE_URL=
# 真 PG 测试用（该角色需能 CREATE DATABASE）；存在时测试改用真 PG，否则用 PGlite
TEST_DATABASE_URL=
# API 监听端口
PORT=
# 运行环境：development / test 才允许开发身份实现；其他值在 B-01 真实登录接入前拒绝启动
NODE_ENV=
# 开发身份签名密钥（≥32 字符，仅 NODE_ENV=development|test）。本地演示放仓库根 .env.local（pnpm demo 缺失时自动生成）
DEV_IDENTITY_SECRET=
# 本地演示（F-025）：NODE_ENV=development 且未设 DATABASE_URL 时 PGlite 数据目录，缺省仓库根 .demo/pglite；
# 相对路径按仓库根解析，且必须位于 .demo/ 之下（重置只删除其中带 PGlite 标记的目录）
LOCAL_PGLITE_DIR=
# R1-T08 定时生效：设为 off 时本进程不运行调度（多实例可全部开启，靠员工行锁去重）；间隔毫秒，缺省 300000（5 分钟）
EMPLOYMENT_ACTIVATION_SCHEDULER=
EMPLOYMENT_ACTIVATION_INTERVAL_MS=
# 平台运维命令行（apps/api/src/ops/platform-cli.ts）：按租户备份的加密密钥（base64 的 32 字节），只放 Secret 管理
BACKUP_ENCRYPTION_KEY=
# 当前部署的代码版本（镜像标签或提交号），写入备份清单
APP_VERSION=

# F-010 人员排序：off 停用本进程调度；间隔毫秒，缺省 10800000（3 小时）
PERSONNEL_ORDER_CODE_SCHEDULER=
PERSONNEL_ORDER_CODE_INTERVAL_MS=

# F-076 360 通用网址作答（docs/08_设计/F-076 §2.4、§2.6、§3.6）。以下密钥只放 Secret 管理，生产缺失或长度不足即启动失败
# 凭据 HMAC 密钥表：`版本:base64密钥` 逗号分隔，至多 4 个、每个 32 字节；当前版本号必须在表内且只增不减
SURVEY360_CREDENTIAL_KEYS=
SURVEY360_CREDENTIAL_KEY_CURRENT=
# 已退役 / 已判定泄露的密钥版本号列表（泄露的必须是退役的子集；泄露列表只增不减，部署即生效）
SURVEY360_CREDENTIAL_KEYS_RETIRED=
SURVEY360_CREDENTIAL_KEYS_COMPROMISED=
# 登录限频键用的独立密钥（不随凭据密钥轮换）
SURVEY360_THROTTLE_KEY=
# 邀请 outbox 秘密字段加密密钥表（`kid:base64`，AES-256-GCM，每个 32 字节）与当前 kid
SURVEY360_OUTBOX_KEYS=
SURVEY360_OUTBOX_KEY_CURRENT=
# 可信代理网段（逗号分隔 CIDR）：只有套接字对端属于这些网段时才采信 X-Forwarded-For，否则按套接字地址限频
TRUSTED_PROXY_CIDRS=
# 对外访问的基础网址（邮件 / 短信里的通用网址由它拼出，非秘密）
PUBLIC_BASE_URL=
# 作答凭据发放开关：缺省关闭；设为 on 前须确认维护任务已启用，否则会出现无人发放的待发邀请
SURVEY360_PORTAL_CREDENTIALS=
# 凭据维护任务（认领发放、清理过期会话与限频行）：设为 off 时本进程不运行；间隔毫秒，缺省 60000
SURVEY360_CREDENTIAL_MAINTENANCE_SCHEDULER=
SURVEY360_CREDENTIAL_MAINTENANCE_INTERVAL_MS=
